    {
      "id": "raw-body-not-json",
      "via": "raw",
      "description": "A body form field that is not JSON answers 422 body_not_json.",
      "key": "valid",
      "raw": {
        "contentType": "multipart/form-data; boundary=docqlrawboundary0000000000000001",
        "bodyUtf8": "--docqlrawboundary0000000000000001\r\nContent-Disposition: form-data; name=\"file\"; filename=\"invoice.pdf\"\r\nContent-Type: application/octet-stream\r\n\r\n%PDF-1.4\n1 0 obj\n<< /Type /Catalog /Pages 2 0 R >>\nendobj\n3 0 obj\n<< /Type /Page /Parent 2 0 R >>\nendobj\n2 0 obj\n<< /Type /Pages /Kids [3 0 R] /Count 1 >>\nendobj\n\r\n--docqlrawboundary0000000000000001\r\nContent-Disposition: form-data; name=\"body\"\r\n\r\nnot json\r\n--docqlrawboundary0000000000000001--\r\n"
      },
      "expect": {
        "status": 422,
        "reason": "body_not_json",
        "requestIdPresent": true
      }
    }
  ],
  "decodeCases": [
    {
      "id": "framework-404",
      "status": 404,
      "headers": {
        "content-type": "application/json",
        "x-request-id": "00000000-0000-4000-8000-000000000404"
      },
      "bodyUtf8": "{\"detail\":\"Not Found\"}\n",
      "expect": {
        "status": 404,
        "reason": null,
        "requestId": "00000000-0000-4000-8000-000000000404"
      }
    },
    {
      "id": "gateway-502-upstream-auth-failed",
      "status": 502,
      "headers": {
        "content-type": "application/json",
