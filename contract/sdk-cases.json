      },
      "expect": {
        "status": 200,
        "reason": null,
        "pageCount": 1,
        "pagesOcr": 0,
        "requestIdPresent": true
      }
    },
    {
      "id": "ok-page-counts",
      "via": "sdk",
      "description": "The pages-3_ocr-1.pdf filename knobs report three pages and one OCR page.",
      "key": "valid",
      "request": {
        "file": {
          "name": "pages-3_ocr-1.pdf",
          "base64": "JVBERi0xLjQKMSAwIG9iago8PCAvVHlwZSAvQ2F0YWxvZyAvUGFnZXMgMiAwIFIgPj4KZW5kb2JqCjMgMCBvYmoKPDwgL1R5cGUgL1BhZ2UgL1BhcmVudCAyIDAgUiA+PgplbmRvYmoKMiAwIG9iago8PCAvVHlwZSAvUGFnZXMgL0tpZHMgWzMgMCBSXSAvQ291bnQgMSA+PgplbmRvYmoK"
        },
        "query": "List every line item."
      },
      "expect": {
        "status": 200,
        "reason": null,
        "pageCount": 3,
        "pagesOcr": 1,
        "requestIdPresent": true
      }
    },
    {
      "id": "ok-thai",
      "via": "sdk",
      "description": "A Thai filename with a Thai query answers 200 with one counted page.",
      "key": "valid",
      "request": {
        "file": {
          "name": "ใบแจ้งหนี้.pdf",
          "base64": "JVBERi0xLjQKMSAwIG9iago8PCAvVHlwZSAvQ2F0YWxvZyAvUGFnZXMgMiAwIFIgPj4KZW5kb2JqCjMgMCBvYmoKPDwgL1R5cGUgL1BhZ2UgL1BhcmVudCAyIDAgUiA+PgplbmRvYmoKMiAwIG9iago8PCAvVHlwZSAvUGFnZXMgL0tpZHMgWzMgMCBSXSAvQ291bnQgMSA+PgplbmRvYmoK"
