        "requestIdPresent": true
      }
    },
    {
      "id": "raw-missing-body-field",
      "via": "raw",
      "description": "A multipart body with only a file part answers 422 missing_body_field.",
      "key": "valid",
      "raw": {
        "contentType": "multipart/form-data; boundary=docqlrawboundary0000000000000001",
        "bodyUtf8": "--docqlrawboundary0000000000000001\r\nContent-Disposition: form-data; name=\"file\"; filename=\"invoice.pdf\"\r\nContent-Type: application/octet-stream\r\n\r\n%PDF-1.4\n1 0 obj\n<< /Type /Catalog /Pages 2 0 R >>\nendobj\n3 0 obj\n<< /Type /Page /Parent 2 0 R >>\nendobj\n2 0 obj\n<< /Type /Pages /Kids [3 0 R] /Count 1 >>\nendobj\n\r\n--docqlrawboundary0000000000000001--\r\n"
