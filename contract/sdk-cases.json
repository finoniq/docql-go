      "expect": {
        "status": 401,
        "reason": "invalid_api_key",
        "requestIdPresent": true
      }
    },
    {
      "id": "too-large",
      "via": "sdk",
      "description": "A 128 KiB upload against the 64 KiB stub cap answers 413 (the cap comes from stubEnv, not the engine's 25 MiB).",
      "key": "valid",
      "request": {
        "file": {
          "name": "big.pdf",
          "repeatByte": "A",
          "length": 131072
        },
        "query": "What is the total amount?"
      },
      "stubConfigDependent": true,
      "expect": {
        "status": 413,
        "reason": "upload_too_large",
        "requestIdPresent": true
      }
    },
    {
      "id": "rate-limited",
      "via": "sdk",
      "description": "The status-429.pdf filename knob answers 429 service_overloaded with Retry-After 5.",
      "key": "valid",
      "request": {
        "file": {
          "name": "status-429.pdf",
          "base64": "JVBERi0xLjQKMSAwIG9iago8PCAvVHlwZSAvQ2F0YWxvZyAvUGFnZXMgMiAwIFIgPj4KZW5kb2JqCjMgMCBvYmoKPDwgL1R5cGUgL1BhZ2UgL1BhcmVudCAyIDAgUiA+PgplbmRvYmoKMiAwIG9iago8PCAvVHlwZSAvUGFnZXMgL0tpZHMgWzMgMCBSXSAvQ291bnQgMSA+PgplbmRvYmoK"
        },
        "query": "What is the total amount?"
      },
      "expect": {
        "status": 429,
        "reason": "service_overloaded",
        "retryAfterSeconds": 5,
        "requestIdPresent": true
      }
    },
    {
      "id": "missing-query",
      "via": "sdk",
      "description": "An empty query string answers 422 missing_query_or_prompt.",
      "key": "valid",
      "request": {
        "file": {
          "name": "invoice.pdf",
          "base64": "JVBERi0xLjQKMSAwIG9iago8PCAvVHlwZSAvQ2F0YWxvZyAvUGFnZXMgMiAwIFIgPj4KZW5kb2JqCjMgMCBvYmoKPDwgL1R5cGUgL1BhZ2UgL1BhcmVudCAyIDAgUiA+PgplbmRvYmoKMiAwIG9iago8PCAvVHlwZSAvUGFnZXMgL0tpZHMgWzMgMCBSXSAvQ291bnQgMSA+PgplbmRvYmoK"
        },
        "query": ""
      },
      "expect": {
        "status": 422,
        "reason": "missing_query_or_prompt",
        "requestIdPresent": true
      }
    },
    {
      "id": "invalid-mode",
      "via": "sdk",
      "description": "mode turbo answers 422 invalid_params.",
      "key": "valid",
      "request": {
        "file": {
          "name": "invoice.pdf",
          "base64": "JVBERi0xLjQKMSAwIG9iago8PCAvVHlwZSAvQ2F0YWxvZyAvUGFnZXMgMiAwIFIgPj4KZW5kb2JqCjMgMCBvYmoKPDwgL1R5cGUgL1BhZ2UgL1BhcmVudCAyIDAgUiA+PgplbmRvYmoKMiAwIG9iago8PCAvVHlwZSAvUGFnZXMgL0tpZHMgWzMgMCBSXSAvQ291bnQgMSA+PgplbmRvYmoK"
        },
        "query": "What is the total amount?",
        "mode": "turbo"
      },
      "expect": {
        "status": 422,
        "reason": "invalid_params",
        "requestIdPresent": true
      }
    },
    {
      "id": "unsupported-file",
      "via": "sdk",
      "description": "A non-PDF upload answers 422 unsupported_file_type.",
      "key": "valid",
      "request": {
        "file": {
          "name": "notes.txt",
          "base64": "aGVsbG8K"
        },
