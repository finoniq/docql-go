{
  "version": 1,
  "contract": "docql-console/stub-v1",
  "stubEnv": {
    "STUB_EXTRA_KEYS": "sdk-contract:sdk-contract-test-key-0001",
    "STUB_TEST_KNOBS": "true",
    "STUB_MAX_UPLOAD_BYTES": "65536"
  },
  "runtimeEnv": {
    "DOCQL_INTERNAL_KEY": "required at runtime: a fresh random value of at least 32 characters; never stored in this file"
  },
  "keys": {
    "valid": "sdk-contract-test-key-0001",
    "invalid": "sdk-contract-never-issued-key-0000",
    "note": "through the gateway edge, valid is replaced by a gateway-issued key; missing means no X-API-Key header"
  },
  "cases": [
    {
      "id": "ok-query",
      "via": "sdk",
      "description": "A one-page PDF with a plain English query answers 200 with one counted page and no OCR.",
      "key": "valid",
      "request": {
        "file": {
          "name": "invoice.pdf",
          "base64": "JVBERi0xLjQKMSAwIG9iago8PCAvVHlwZSAvQ2F0YWxvZyAvUGFnZXMgMiAwIFIgPj4KZW5kb2JqCjMgMCBvYmoKPDwgL1R5cGUgL1BhZ2UgL1BhcmVudCAyIDAgUiA+PgplbmRvYmoKMiAwIG9iago8PCAvVHlwZSAvUGFnZXMgL0tpZHMgWzMgMCBSXSAvQ291bnQgMSA+PgplbmRvYmoK"
        },
        "query": "What is the total amount?"
      },
      "expect": {
        "status": 200,
        "reason": null,
        "pageCount": 1,
        "pagesOcr": 0,
        "requestIdPresent": true
      }
    },
    {
      "id": "ok-prompt",
      "via": "sdk",
      "description": "A one-page PDF with a prompt instead of a query answers 200.",
      "key": "valid",
      "request": {
        "file": {
          "name": "invoice.pdf",
          "base64": "JVBERi0xLjQKMSAwIG9iago8PCAvVHlwZSAvQ2F0YWxvZyAvUGFnZXMgMiAwIFIgPj4KZW5kb2JqCjMgMCBvYmoKPDwgL1R5cGUgL1BhZ2UgL1BhcmVudCAyIDAgUiA+PgplbmRvYmoKMiAwIG9iago8PCAvVHlwZSAvUGFnZXMgL0tpZHMgWzMgMCBSXSAvQ291bnQgMSA+PgplbmRvYmoK"
        },
