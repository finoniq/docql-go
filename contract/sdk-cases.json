      },
      "bodyUtf8": "{\"error_info\":\"the gateway could not authenticate to the upstream service\",\"status_code\":502,\"metadata\":{\"reason\":\"upstream_auth_failed\",\"request_id\":\"00000000-0000-4000-8000-000000000502\"}}\n",
      "expect": {
