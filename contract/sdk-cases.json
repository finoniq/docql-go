      "id": "corrupted-pdf",
      "via": "sdk",
      "description": "A PDF header with no page objects answers 422 corrupted_file.",
      "key": "valid",
      "request": {
        "file": {
          "name": "corrupted.pdf",
          "base64": "JVBERi0xLjQKJSVFT0YK"
        },
        "query": "What is the total amount?"
      },
      "expect": {
        "status": 422,
        "reason": "corrupted_file",
        "requestIdPresent": true
      }
    },
    {
      "id": "over-time-budget",
      "via": "sdk",
      "description": "The pages-50.pdf knob with mode fast exceeds the 41-page fast ceiling and answers 422.",
      "key": "valid",
      "request": {
        "file": {
          "name": "pages-50.pdf",
          "base64": "JVBERi0xLjQKMSAwIG9iago8PCAvVHlwZSAvQ2F0YWxvZyAvUGFnZXMgMiAwIFIgPj4KZW5kb2JqCjMgMCBvYmoKPDwgL1R5cGUgL1BhZ2UgL1BhcmVudCAyIDAgUiA+PgplbmRvYmoKMiAwIG9iago8PCAvVHlwZSAvUGFnZXMgL0tpZHMgWzMgMCBSXSAvQ291bnQgMSA+PgplbmRvYmoK"
        },
        "query": "Extract everything.",
        "mode": "fast"
      },
      "expect": {
        "status": 422,
        "reason": "document_exceeds_time_budget",
        "requestIdPresent": true
      }
    },
    {
      "id": "raw-unsupported-media-type",
      "via": "raw",
      "description": "A JSON body instead of multipart answers 415 unsupported_media_type.",
      "key": "valid",
      "raw": {
        "contentType": "application/json",
        "bodyUtf8": "{\"query\":\"What is the total amount?\"}"
      },
      "expect": {
        "status": 415,
        "reason": "unsupported_media_type",
        "requestIdPresent": true
      }
    },
    {
      "id": "raw-missing-key",
      "via": "raw",
      "description": "A valid multipart request without an X-API-Key header answers 401 invalid_api_key.",
      "key": "missing",
      "raw": {
        "contentType": "multipart/form-data; boundary=docqlrawboundary0000000000000001",
        "bodyUtf8": "--docqlrawboundary0000000000000001\r\nContent-Disposition: form-data; name=\"file\"; filename=\"invoice.pdf\"\r\nContent-Type: application/octet-stream\r\n\r\n%PDF-1.4\n1 0 obj\n<< /Type /Catalog /Pages 2 0 R >>\nendobj\n3 0 obj\n<< /Type /Page /Parent 2 0 R >>\nendobj\n2 0 obj\n<< /Type /Pages /Kids [3 0 R] /Count 1 >>\nendobj\n\r\n--docqlrawboundary0000000000000001\r\nContent-Disposition: form-data; name=\"body\"\r\n\r\n{\"query\":\"What is the total amount?\"}\r\n--docqlrawboundary0000000000000001--\r\n"
      },
      "expect": {
        "status": 401,
        "reason": "invalid_api_key",
        "requestIdPresent": true
      }
    },
    {
      "id": "raw-missing-file-part",
      "via": "raw",
      "description": "A multipart body with only a body part answers 422 missing_file_part.",
      "key": "valid",
      "raw": {
        "contentType": "multipart/form-data; boundary=docqlrawboundary0000000000000001",
        "bodyUtf8": "--docqlrawboundary0000000000000001\r\nContent-Disposition: form-data; name=\"body\"\r\n\r\n{\"query\":\"What is the total amount?\"}\r\n--docqlrawboundary0000000000000001--\r\n"
      },
      "expect": {
        "status": 422,
